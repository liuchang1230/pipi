{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "out"
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/renderer/src/components/diff-utils.ts",
    "electron.vite.config.ts"
  ],
  // pi-extension sources we SHIP but do not compile: they are embedded as text
  // (`?raw`) and loaded by pi itself, and they import pi's internal packages
  // (@earendil-works/pi-agent-core / pi-ai / pi-tui / typebox) plus `.ts` module
  // specifiers, neither of which the app depends on or supports. Their
  // correctness is established by pi loading them at runtime, not by tsc.
  "exclude": [
    "src/main/extensions/delegation"
  ]
}